{
  "name": "claude-media-bridge",
  "version": "2.2.0",
  "description": "Media generation MCP bridge and Claude Code plugin: Nano Banana 2 via one-click Google sign-in, Google AI Studio, FLUX, Stable Diffusion, DALL-E and Higgsfield.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "claude-media-bridge": "bin/cli.mjs"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "node --test --experimental-strip-types test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "dev": "node --experimental-strip-types src/index.ts",
    "screenshots": "python3 scripts/screenshot.py",
    "setup": "node bin/cli.mjs setup"
  },
  "keywords": [
    "claude-code",
    "claude-code-plugin",
    "mcp",
    "omniroute",
    "nano-banana",
    "gemini",
    "google-ai-studio",
    "flux",
    "stable-diffusion",
    "higgsfield",
    "media-generation",
    "image-generation"
  ],
  "author": "Mert Gövse (https://github.com/mertgoevse-wq)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mertgoevse-wq/claude-media-bridge.git"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^2.1.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "bin",
    "dist",
    "skills",
    "hooks",
    ".claude-plugin",
    ".mcp.json",
    "install.sh",
    "README.md",
    "LICENSE"
  ]
}
